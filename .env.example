# Copy these values into PyCharm Run Configuration -> Environment variables.
# Create the database separately in MySQL Workbench before running init-db.
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/campus_study_rooms?charset=utf8mb4
SECRET_KEY=replace-with-a-long-random-secret
# Set to 1 only when serving behind HTTPS.
SESSION_COOKIE_SECURE=0
